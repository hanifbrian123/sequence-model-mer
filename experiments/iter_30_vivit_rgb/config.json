{
  "seed": 42,
  "T": 32,
  "img_size": 128,
  "base_size": 128,
  "input_mode": "rgb",
  "backbone": "vivit",
  "pretrained": true,
  "dropout": 0.2,
  "epochs": 24,
  "lr": 6e-05,
  "weight_decay": 0.02,
  "batch_size": 8,
  "class_weighting": true,
  "label_smoothing": 0.0,
  "hflip": true,
  "color_jitter": 0.1,
  "temporal_jitter": true,
  "amp": true,
  "eval_last_k": 3,
  "tta": 5,
  "cache_dir": "cache/frames128",
  "index": "cache/index_emotion.csv",
  "class_names": [
    "happiness",
    "disgust",
    "repression",
    "surprise",
    "others"
  ],
  "name": "iter_30_vivit_rgb",
  "resize_to": 224,
  "modality": "rgb",
  "temporal_span": "onset_offset",
  "grad_checkpoint": true,
  "head_lr": 0.003,
  "llrd_decay": 0.85,
  "warmup_epochs": 3,
  "freeze_epochs": 2,
  "grad_accum": 1,
  "loss": "focal",
  "focal_gamma": 1.5,
  "random_erase": 0.1
}